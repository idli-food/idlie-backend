# Django <-> Postgres connection (use DB_HOST=db when running via docker-compose)
DB_NAME=idli_db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=db
DB_PORT=5432
SECRET_KEY=
DEBUG=True
# Prod: set to the API host, e.g. api.idli.food
ALLOWED_HOSTS=*
# Comma-separated, scheme required. Prod: https://api.idli.food
CSRF_TRUSTED_ORIGINS=
# Comma-separated, scheme required. Prod: https://www.idli.food,https://idli.food
CORS_ALLOWED_ORIGINS=

# Django superuser bootstrapped by startup.sh
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PHONE=9000000000

# Read by the postgis container itself to initialize the database
POSTGRES_DB=idli_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Celery / Redis (use redis:6379 when running via docker-compose)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

AWS_QUERYSTRING_AUTH=
AWS_DEFAULT_ACL=
AWS_S3_SIGNATURE_VERSION=

GOOGLE_MAPS_API_KEY=

# Google OAuth ("Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/
FRONTEND_URL=http://localhost:3000

# Auth cookie policy. "None" (needs HTTPS) for a cross-domain frontend; "Lax" if
# the frontend and API share a site. Set AUTH_COOKIE_SECURE=False only for a
# plain-HTTP same-site local setup.
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=True
